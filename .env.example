# No credentials needed for the explicitly labeled local demo.
# With both values set, local development automatically uses live Jev through OpenRouter.
OPENROUTER_API_KEY=
# A System One decision model, e.g. typesafe/jev-1.13.
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_MS=15000
# Optional: live requires credentials, demo is allowed only outside production.
# AI_MODE=demo

PORT=3001
# Local mode persists to this JSON file and embeds the worker in the web process.
DATA_FILE=.data/state.json

# To exercise the production-style services locally, start docker compose,
# uncomment these URLs and run a separate worker (see README).
# DATABASE_URL=postgresql://jev:local-development-only@localhost:5432/mailroom
# REDIS_URL=redis://localhost:6379
# Required in production. Generate with: openssl rand -hex 32
RECEIPT_SECRET=

MAX_QUEUE=40
SUBMISSIONS_PER_MINUTE=5
# Name checks per IP per minute; each new name Jev checks counts toward DAILY_AI_LIMIT.
NAMES_PER_MINUTE=10
AI_CONCURRENCY=2
DAILY_AI_LIMIT=500
